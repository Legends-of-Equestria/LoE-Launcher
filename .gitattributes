# Auto detect text files and perform LF normalization
*              text=auto

*.cs           text diff=csharp
*.axaml        text
*.sln          text eol=crlf
*.slnx         text eol=crlf
*.csproj       text eol=crlf

# Scripts run on Linux/macOS (CI, Flatpak) and must stay LF
*.sh           text eol=lf diff=bash
*.py           text diff=python
*.md           text diff=markdown

# Binary assets
*.png          binary
*.ico          binary
*.icns         binary
