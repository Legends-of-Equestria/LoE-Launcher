<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LoE_Launcher.ViewModels"
             x:Class="LoE_Launcher.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             x:CompileBindings="True"
             FontFamily="Segoe UI, SF Pro Display, Arial, sans-serif">

    <UserControl.Resources>
        <ControlTheme x:Key="OptionsNavItem" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,10,2" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#D0FFFFFF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="3,0,0,0"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.12" />
                            </Transitions>
                        </Border.Transitions>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Padding="11,8,14,8"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontSize="{TemplateBinding FontSize}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="#0FFFFFFF" />
                <Setter Property="Foreground" Value="White" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Background" Value="#08FFFFFF" />
            </Style>
            <Style Selector="^.selected">
                <Setter Property="Background" Value="{StaticResource NavSelectedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                <Setter Property="Foreground" Value="White" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="OptionsRowButton" TargetType="Button" BasedOn="{StaticResource GlassDialogButton}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource GoldSoftBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0.45" />
                <Setter Property="Cursor" Value="Arrow" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="OptionsToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Border x:Name="PART_Track"
                                CornerRadius="11"
                                Background="#18FFFFFF"
                                BorderThickness="1"
                                BorderBrush="{StaticResource GoldSoftBrush}" />
                        <Border x:Name="PART_Knob"
                                Width="16" Height="16"
                                CornerRadius="8"
                                Margin="3,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="#D0FFFFFF">
                            <Border.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                    </Panel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#PART_Track">
                <Setter Property="Background" Value="#30FFFFFF" />
            </Style>
            <Style Selector="^:checked /template/ Border#PART_Track">
                <Setter Property="Background" Value="{StaticResource PaintedPurpleBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource PaintedPurpleFrameBrush}" />
            </Style>
            <Style Selector="^:checked /template/ Border#PART_Knob">
                <Setter Property="Background" Value="White" />
                <Setter Property="RenderTransform" Value="translateX(18px)" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="OptionsCloseButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="PART_Border"
                            CornerRadius="14"
                            BorderThickness="1"
                            BorderBrush="{StaticResource GoldSoftBrush}"
                            Background="{StaticResource CloseButtonBrush}">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                            </Transitions>
                        </Border.Transitions>
                        <Path x:Name="PART_Cross"
                              Data="M0,0 L9,9 M9,0 L0,9"
                              Stroke="#D0FFFFFF"
                              StrokeThickness="1.5"
                              StrokeLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#PART_Border">
                <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
            </Style>
            <Style Selector="^:pointerover /template/ Path#PART_Cross">
                <Setter Property="Stroke" Value="White" />
            </Style>
            <Style Selector="^:pressed /template/ Border#PART_Border">
                <Setter Property="BorderBrush" Value="{StaticResource GoldStrongBrush}" />
                <Setter Property="Background" Value="{StaticResource PlumGlassPressedBrush}" />
            </Style>
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.pageTitle">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="0.6" />
            <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Border.row">
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <Style Selector="Rectangle.divider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="{StaticResource RowDividerBrush}" />
        </Style>
        <Style Selector="TextBlock.rowName">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBlock.rowHint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#A0FFFFFF" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style Selector="TextBlock.rowValue">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#D0FFFFFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxWidth" Value="360" />
        </Style>
        <Style Selector="TextBlock.path">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#D0FFFFFF" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#A0FFFFFF" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}" />
        </Style>
        <Style Selector="Button.danger /template/ Border#PART_Border">
            <Setter Property="Background" Value="{StaticResource DangerFillBrush}" />
        </Style>
        <Style Selector="Button.danger:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource DangerHoverBorderBrush}" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="{StaticResource DangerHoverFillBrush}" />
        </Style>
        <Style Selector="Button.danger:pressed">
            <Setter Property="BorderBrush" Value="{StaticResource DangerPressedBorderBrush}" />
        </Style>
        <Style Selector="Button.danger:pressed /template/ Border#PART_Border">
            <Setter Property="Background" Value="{StaticResource DangerPressedFillBrush}" />
        </Style>
    </UserControl.Styles>

    <Border Background="{StaticResource PlumDialogBrush}"
            BorderBrush="{StaticResource GoldBrush}"
            BorderThickness="1"
            CornerRadius="10"
            BoxShadow="0 4 20 0 #73000000">
        <Border CornerRadius="9" ClipToBounds="True">
            <Grid ColumnDefinitions="184,*">
                <Border Grid.Column="0" Background="{StaticResource PanelSidebarBrush}">
                    <StackPanel>
                        <TextBlock Text="Options"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource GoldBrush}"
                                   Margin="24,22,0,16" />
                        <Button Theme="{StaticResource OptionsNavItem}"
                                Content="Game"
                                Classes.selected="{Binding IsGamePage}"
                                Command="{Binding SelectPageCommand}"
                                CommandParameter="{x:Static vm:OptionsPage.Game}" />
                        <Button Theme="{StaticResource OptionsNavItem}"
                                Content="Launcher"
                                Classes.selected="{Binding IsLauncherPage}"
                                Command="{Binding SelectPageCommand}"
                                CommandParameter="{x:Static vm:OptionsPage.Launcher}" />
                        <Button Theme="{StaticResource OptionsNavItem}"
                                Content="Help"
                                Classes.selected="{Binding IsHelpPage}"
                                Command="{Binding SelectPageCommand}"
                                CommandParameter="{x:Static vm:OptionsPage.Help}" />
                        <Button Theme="{StaticResource OptionsNavItem}"
                                Content="About"
                                Classes.selected="{Binding IsAboutPage}"
                                Command="{Binding SelectPageCommand}"
                                CommandParameter="{x:Static vm:OptionsPage.About}" />
                    </StackPanel>
                </Border>

                <Panel Grid.Column="1">
                    <Panel Margin="28,22">
                        <StackPanel IsVisible="{Binding IsGamePage}">
                            <TextBlock Classes="pageTitle" Text="Game" />

                            <TextBlock Classes="section" Text="INSTALL LOCATION" />
                            <Border Classes="card">
                                <Border Classes="row">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Classes="rowName" Text="Game folder" />
                                            <TextBlock Classes="path"
                                                       Text="{Binding GameFolderPath}"
                                                       ToolTip.Tip="{Binding GameFolderPath}" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Theme="{StaticResource OptionsRowButton}"
                                                Content="Change…"
                                                Margin="12,0,0,0"
                                                IsVisible="{Binding CanChangeLocation}"
                                                IsEnabled="{Binding !IsBusy}" />
                                    </Grid>
                                </Border>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="2,8,0,0">
                                <TextBlock Classes="muted" Text="{Binding GameSizeText, StringFormat='{}{0} on disk.'}" />
                                <TextBlock Classes="muted"
                                           Text="Changing it moves your installed game to the new folder."
                                           IsVisible="{Binding CanChangeLocation}" />
                            </StackPanel>

                            <TextBlock Classes="section" Text="MAINTENANCE" />
                            <Border Classes="card">
                                <StackPanel>
                                    <Border Classes="row">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Classes="rowName" Text="Repair game files" />
                                                <TextBlock Classes="rowHint" Text="Verify and fix corrupted game files" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Theme="{StaticResource OptionsRowButton}"
                                                    Content="Repair"
                                                    Margin="12,0,0,0"
                                                    IsEnabled="{Binding !IsBusy}"
                                                    Command="{Binding RepairGameCommand}" />
                                        </Grid>
                                    </Border>
                                    <Rectangle Classes="divider" />
                                    <Border Classes="row">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Classes="rowName" Text="Delete game files" />
                                                <TextBlock Classes="rowHint" Text="Remove all downloaded game files" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Theme="{StaticResource OptionsRowButton}"
                                                    Classes="danger"
                                                    Content="Delete"
                                                    Margin="12,0,0,0"
                                                    IsEnabled="{Binding !IsBusy}"
                                                    Command="{Binding DeleteGameCommand}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsLauncherPage}">
                            <TextBlock Classes="pageTitle" Text="Launcher" />

                            <TextBlock Classes="section" Text="WHEN THE GAME STARTS" />
                            <Border Classes="card">
                                <Border Classes="row">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Classes="rowName" Text="Close the launcher" />
                                            <TextBlock Classes="rowHint" Text="Otherwise it stays open in the background" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1"
                                                      Theme="{StaticResource OptionsToggle}"
                                                      Margin="12,0,0,0"
                                                      AutomationProperties.Name="Close the launcher"
                                                      IsChecked="{Binding CloseAfterLaunch, Mode=TwoWay}" />
                                    </Grid>
                                </Border>
                            </Border>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsHelpPage}">
                            <TextBlock Classes="pageTitle" Text="Help" />

                            <TextBlock Classes="section" Text="LOGS" />
                            <Border Classes="card">
                                <StackPanel>
                                    <Border Classes="row">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Classes="rowName" Text="Game logs" />
                                                <TextBlock Classes="rowHint" Text="For game crashes and gameplay issues" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Theme="{StaticResource OptionsRowButton}"
                                                    Content="Open"
                                                    Margin="12,0,0,0"
                                                    Command="{Binding OpenGameLogsCommand}" />
                                        </Grid>
                                    </Border>
                                    <Rectangle Classes="divider" />
                                    <Border Classes="row">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Classes="rowName" Text="Launcher logs" />
                                                <TextBlock Classes="rowHint" Text="For launcher and download issues" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Theme="{StaticResource OptionsRowButton}"
                                                    Content="Open"
                                                    Margin="12,0,0,0"
                                                    Command="{Binding OpenLauncherLogsCommand}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <TextBlock Classes="muted"
                                       Margin="2,8,0,0"
                                       Text="Attach these when you report a problem on Discord or the forums." />
                        </StackPanel>

                        <DockPanel IsVisible="{Binding IsAboutPage}">
                            <StackPanel DockPanel.Dock="Bottom"
                                        Orientation="Horizontal"
                                        Spacing="12"
                                        Margin="-4,0,0,-6">
                                <Button Classes="LinkButton"
                                        Content="Third-party notices"
                                        Command="{Binding OpenThirdPartyNoticesCommand}" />
                                <Button Classes="LinkButton"
                                        Content="Tester access"
                                        Command="{Binding OpenTesterAccessCommand}" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Classes="pageTitle" Text="About" />

                                <TextBlock Classes="section" Text="VERSIONS" />
                                <Border Classes="card">
                                    <StackPanel>
                                        <Border Classes="row">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Classes="rowName" Text="Launcher" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Classes="rowValue" Text="{Binding LauncherVersionText}" />
                                            </Grid>
                                        </Border>
                                        <Rectangle Classes="divider" />
                                        <Border Classes="row">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Classes="rowName" Text="Game" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Classes="rowValue"
                                                           Text="{Binding GameVersionText}"
                                                           ToolTip.Tip="{Binding GameVersionText}" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DockPanel>
                    </Panel>

                    <Button Theme="{StaticResource OptionsCloseButton}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,10,12,0"
                            ToolTip.Tip="Close"
                            Command="{Binding CloseCommand}" />
                </Panel>
            </Grid>
        </Border>
    </Border>
</UserControl>
