<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LoE_Launcher.ViewModels"
             x:Class="LoE_Launcher.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             x:CompileBindings="True"
             FontFamily="Segoe UI, SF Pro Display, Arial, sans-serif">

    <UserControl.Resources>
        <ControlTheme x:Key="OptionsNavItem" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,10,2" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#D0FFFFFF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="3,0,0,0"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.12" />
                            </Transitions>
                        </Border.Transitions>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Padding="11,8,14,8"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontSize="{TemplateBinding FontSize}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="#0FFFFFFF" />
                <Setter Property="Foreground" Value="White" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Background" Value="#08FFFFFF" />
            </Style>
            <Style Selector="^.selected">
                <Setter Property="Background" Value="{StaticResource NavSelectedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                <Setter Property="Foreground" Value="White" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="OptionsRowButton" TargetType="Button" BasedOn="{StaticResource GlassDialogButton}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource GoldSoftBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0.45" />
                <Setter Property="Cursor" Value="Arrow" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="OptionsToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Border x:Name="PART_Track"
                                CornerRadius="11"
                                Background="#18FFFFFF"
                                BorderThickness="1"
                                BorderBrush="{StaticResource GoldSoftBrush}" />
                        <Border x:Name="PART_Knob"
                                Width="16" Height="16"
                                CornerRadius="8"
                                Margin="3,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="#D0FFFFFF">
                            <Border.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                    </Panel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#PART_Track">
                <Setter Property="Background" Value="#30FFFFFF" />
            </Style>
            <Style Selector="^:checked /template/ Border#PART_Track">
                <Setter Property="Background" Value="{StaticResource PaintedPurpleBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource PaintedPurpleFrameBrush}" />
            </Style>
            <Style Selector="^:checked /template/ Border#PART_Knob">
                <Setter Property="Background" Value="White" />
                <Setter Property="RenderTransform" Value="translateX(18px)" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="OptionsSegment" TargetType="RadioButton">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#D0FFFFFF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.12" />
                            </Transitions>
                        </Border.Transitions>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="#0FFFFFFF" />
                <Setter Property="Foreground" Value="White" />
            </Style>
            <Style Selector="^:checked">
                <Setter Property="Background" Value="{StaticResource GoldSelectionBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="OptionsCloseButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="PART_Border"
                            CornerRadius="14"
                            BorderThickness="1"
                            BorderBrush="{StaticResource GoldSoftBrush}"
                            Background="{StaticResource CloseButtonBrush}">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                            </Transitions>
                        </Border.Transitions>
                        <Path x:Name="PART_Cross"
                              Data="M0,0 L9,9 M9,0 L0,9"
                              Stroke="#D0FFFFFF"
                              StrokeThickness="1.5"
                              StrokeLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#PART_Border">
                <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
            </Style>
            <Style Selector="^:pointerover /template/ Path#PART_Cross">
                <Setter Property="Stroke" Value="White" />
            </Style>
            <Style Selector="^:pressed /template/ Border#PART_Border">
                <Setter Property="BorderBrush" Value="{StaticResource GoldStrongBrush}" />
                <Setter Property="Background" Value="{StaticResource PlumGlassPressedBrush}" />
            </Style>
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.pageTitle">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="0.6" />
            <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Border.row">
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <Style Selector="Rectangle.divider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="{StaticResource RowDividerBrush}" />
        </Style>
        <Style Selector="TextBlock.rowName">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBlock.rowHint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#A0FFFFFF" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style Selector="TextBlock.rowValue">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#D0FFFFFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxWidth" Value="360" />
        </Style>
        <Style Selector="TextBlock.path">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#D0FFFFFF" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#A0FFFFFF" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="Border.segments">
            <Setter Property="Padding" Value="2" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource GoldSoftBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.segments:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="Border.segments:disabled RadioButton">
            <Setter Property="Cursor" Value="Arrow" />
        </Style>

        <Style Selector="TextBox.field">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource PlumPanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GoldSoftBrush}" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="SelectionBrush" Value="{StaticResource GoldSelectionBrush}" />
            <Setter Property="SelectionForegroundBrush" Value="White" />
            <Setter Property="PlaceholderForeground" Value="#80FFFFFF" />
        </Style>
        <Style Selector="TextBox.field /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource PlumPanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GoldSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBox.field:pointerover">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBox.field:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{StaticResource GoldStrongBrush}" />
        </Style>
        <Style Selector="TextBox.field:focus">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource PlumBadgeBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
        </Style>

        <Style Selector="Button.LinkButton:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="Button.LinkButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}" />
        </Style>
        <Style Selector="Button.danger /template/ Border#PART_Border">
            <Setter Property="Background" Value="{StaticResource DangerFillBrush}" />
        </Style>
        <Style Selector="Button.danger:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource DangerHoverBorderBrush}" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="{StaticResource DangerHoverFillBrush}" />
        </Style>
        <Style Selector="Button.danger:pressed">
            <Setter Property="BorderBrush" Value="{StaticResource DangerPressedBorderBrush}" />
        </Style>
        <Style Selector="Button.danger:pressed /template/ Border#PART_Border">
            <Setter Property="Background" Value="{StaticResource DangerPressedFillBrush}" />
        </Style>
    </UserControl.Styles>

    <Border Background="{StaticResource PlumDialogBrush}"
            BorderBrush="{StaticResource GoldBrush}"
            BorderThickness="1"
            CornerRadius="10"
            BoxShadow="0 4 20 0 #73000000">
        <Border CornerRadius="9" ClipToBounds="True">
            <Grid ColumnDefinitions="184,*">
                <Border Grid.Column="0" Background="{StaticResource PanelSidebarBrush}">
                    <StackPanel>
                        <TextBlock Text="Options"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource GoldBrush}"
                                   Margin="24,22,0,16" />
                        <Button Theme="{StaticResource OptionsNavItem}"
                                Content="Game"
                                Classes.selected="{Binding IsGamePage}"
                                Command="{Binding SelectPageCommand}"
                                CommandParameter="{x:Static vm:OptionsPage.Game}" />
                        <Button Theme="{StaticResource OptionsNavItem}"
                                Content="Launcher"
                                Classes.selected="{Binding IsLauncherPage}"
                                Command="{Binding SelectPageCommand}"
                                CommandParameter="{x:Static vm:OptionsPage.Launcher}" />
                        <Button Theme="{StaticResource OptionsNavItem}"
                                Content="Help"
                                Classes.selected="{Binding IsHelpPage}"
                                Command="{Binding SelectPageCommand}"
                                CommandParameter="{x:Static vm:OptionsPage.Help}" />
                        <Button Theme="{StaticResource OptionsNavItem}"
                                Content="About"
                                Classes.selected="{Binding IsAboutPage}"
                                Command="{Binding SelectPageCommand}"
                                CommandParameter="{x:Static vm:OptionsPage.About}" />
                    </StackPanel>
                </Border>

                <Panel Grid.Column="1">
                    <ScrollViewer x:Name="pageScroll"
                                  Classes="ChangelogScroll"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <Panel Margin="28,22">
                            <StackPanel IsVisible="{Binding IsGamePage}">
                                <TextBlock Classes="pageTitle" Text="Game" />

                                <StackPanel IsVisible="{Binding Tester.ShowChannel}">
                                    <TextBlock Classes="section" Text="BUILD CHANNEL" />
                                    <Border Classes="card">
                                        <Border Classes="row">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Classes="rowName" Text="Channel" VerticalAlignment="Center" />
                                                <Border Grid.Column="1"
                                                        Classes="segments"
                                                        Margin="12,0,0,0"
                                                        IsEnabled="{Binding !IsBusy}">
                                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                                        <RadioButton Theme="{StaticResource OptionsSegment}"
                                                                     GroupName="Channel"
                                                                     Content="Live"
                                                                     IsChecked="{Binding Tester.UseLiveChannel, Mode=TwoWay}" />
                                                        <RadioButton Theme="{StaticResource OptionsSegment}"
                                                                     GroupName="Channel"
                                                                     Content="Dev builds"
                                                                     IsChecked="{Binding Tester.UseDevChannel, Mode=TwoWay}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Border>
                                    <DockPanel Margin="2,6,0,0">
                                        <Button DockPanel.Dock="Right"
                                                Classes="LinkButton"
                                                Content="Remove tester access"
                                                Margin="12,0,-4,0"
                                                VerticalAlignment="Center"
                                                IsEnabled="{Binding !IsBusy}"
                                                Command="{Binding Tester.RemoveTesterAccessCommand}" />
                                        <TextBlock Classes="muted"
                                                   VerticalAlignment="Center"
                                                   Text="Dev builds install to a separate folder." />
                                    </DockPanel>
                                </StackPanel>

                                <TextBlock Classes="section" Text="INSTALL LOCATION" />
                                <Border Classes="card">
                                    <Border Classes="row">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Classes="rowName" Text="Game folder" />
                                                <TextBlock Classes="path"
                                                           Text="{Binding GameFolderPath}"
                                                           ToolTip.Tip="{Binding GameFolderPath}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Spacing="8"
                                                        Margin="12,0,0,0"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding CanChangeLocation}">
                                                <Button Classes="LinkButton"
                                                        Content="Reset to default"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding ShowResetLocation}"
                                                        IsEnabled="{Binding CanMove}"
                                                        Command="{Binding ResetLocationCommand}" />
                                                <Button Theme="{StaticResource OptionsRowButton}"
                                                        Content="Change…"
                                                        IsEnabled="{Binding CanMove}"
                                                        Command="{Binding ChangeLocationCommand}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Border>
                                <TextBlock Classes="muted"
                                           Margin="2,8,0,0"
                                           Text="{Binding LocationNote}"
                                           IsVisible="{Binding HasLocationNote}" />

                                <TextBlock Classes="section" Text="MAINTENANCE" />
                                <Border Classes="card">
                                    <StackPanel>
                                        <Border Classes="row">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Classes="rowName" Text="Repair game files" />
                                                    <TextBlock Classes="rowHint" Text="Verify and fix corrupted game files" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Theme="{StaticResource OptionsRowButton}"
                                                        Content="Repair"
                                                        Margin="12,0,0,0"
                                                        IsEnabled="{Binding CanRepair}"
                                                        Command="{Binding RepairGameCommand}" />
                                            </Grid>
                                        </Border>
                                        <Rectangle Classes="divider" />
                                        <Border Classes="row">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Classes="rowName" Text="Delete game files" />
                                                    <TextBlock Classes="rowHint" Text="Remove all downloaded game files" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Theme="{StaticResource OptionsRowButton}"
                                                        Classes="danger"
                                                        Content="Delete"
                                                        Margin="12,0,0,0"
                                                        IsEnabled="{Binding CanDelete}"
                                                        Command="{Binding DeleteGameCommand}" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <TextBlock FontSize="12" Foreground="#A0FFFFFF" Margin="2,8,0,0" TextWrapping="Wrap"
                                           Text="Needs an internet connection to tell which files belong to the game."
                                           IsVisible="{Binding ShowFileListHint}" />
                            </StackPanel>

                            <StackPanel IsVisible="{Binding IsLauncherPage}">
                                <TextBlock Classes="pageTitle" Text="Launcher" />

                                <TextBlock Classes="section" Text="LAUNCHING" />
                                <Border Classes="card">
                                    <Border Classes="row">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Classes="rowName" Text="Close the launcher when the game starts" />
                                                <TextBlock Classes="rowHint" Text="Turn this off to keep the launcher open while you play" />
                                            </StackPanel>
                                            <ToggleButton Grid.Column="1"
                                                          Theme="{StaticResource OptionsToggle}"
                                                          Margin="12,0,0,0"
                                                          AutomationProperties.Name="Close the launcher when the game starts"
                                                          IsChecked="{Binding CloseAfterLaunch, Mode=TwoWay}" />
                                        </Grid>
                                    </Border>
                                </Border>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding IsHelpPage}">
                                <TextBlock Classes="pageTitle" Text="Help" />

                                <TextBlock Classes="section" Text="LOGS" />
                                <Border Classes="card">
                                    <StackPanel>
                                        <Border Classes="row">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Classes="rowName" Text="Game logs" />
                                                    <TextBlock Classes="rowHint" Text="For game crashes and gameplay issues" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Theme="{StaticResource OptionsRowButton}"
                                                        Content="Open"
                                                        Margin="12,0,0,0"
                                                        Command="{Binding OpenGameLogsCommand}" />
                                            </Grid>
                                        </Border>
                                        <Rectangle Classes="divider" />
                                        <Border Classes="row">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Classes="rowName" Text="Launcher logs" />
                                                    <TextBlock Classes="rowHint" Text="For launcher and download issues" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Theme="{StaticResource OptionsRowButton}"
                                                        Content="Open"
                                                        Margin="12,0,0,0"
                                                        Command="{Binding OpenLauncherLogsCommand}" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <TextBlock Classes="muted"
                                           Margin="2,8,0,0"
                                           Text="Attach these when you report a problem." />
                            </StackPanel>

                            <Panel IsVisible="{Binding IsAboutPage}">
                                <DockPanel IsVisible="{Binding !IsTesterLoginOpen}">
                                    <StackPanel DockPanel.Dock="Bottom"
                                                Orientation="Horizontal"
                                                Spacing="12"
                                                Margin="-4,0,0,-6">
                                        <Button Classes="LinkButton"
                                                Content="Third-party notices"
                                                Command="{Binding OpenThirdPartyNoticesCommand}" />
                                        <Button Classes="LinkButton"
                                                Content="Tester access"
                                                IsVisible="{Binding Tester.ShowLogin}"
                                                Command="{Binding OpenTesterLoginCommand}" />
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock Classes="pageTitle" Text="About" />

                                        <TextBlock Classes="section" Text="VERSIONS" />
                                        <Border Classes="card">
                                            <StackPanel>
                                                <Border Classes="row">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Classes="rowName" Text="Launcher" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Classes="rowValue" Text="{Binding LauncherVersionText}" />
                                                    </Grid>
                                                </Border>
                                                <Rectangle Classes="divider" />
                                                <Border Classes="row">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Classes="rowName" Text="Game" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Classes="rowValue"
                                                                   Text="{Binding GameVersionText}"
                                                                   ToolTip.Tip="{Binding GameVersionText}" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>

                                <StackPanel IsVisible="{Binding IsTesterLoginOpen}">
                                    <TextBlock Classes="pageTitle" Text="Tester access" />
                                    <TextBlock Classes="muted"
                                               Margin="0,6,0,0"
                                               Text="Log in with your forum account." />

                                    <Border Classes="card" Margin="0,14,0,0" Padding="14">
                                        <StackPanel Spacing="10">
                                            <TextBox x:Name="testerUsername"
                                                     Classes="field"
                                                     PlaceholderText="Forum username"
                                                     Text="{Binding Tester.Username, Mode=TwoWay}" />
                                            <TextBox Classes="field"
                                                     PlaceholderText="Password"
                                                     PasswordChar="•"
                                                     Text="{Binding Tester.Password, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,14,0,0">
                                        <Button Theme="{StaticResource OptionsRowButton}"
                                                BorderBrush="{StaticResource GoldBrush}"
                                                MinWidth="96"
                                                Content="Log in"
                                                IsDefault="{Binding IsTesterLoginOpen}"
                                                IsEnabled="{Binding !IsBusy}"
                                                Command="{Binding Tester.LogInCommand}" />
                                        <Button Classes="LinkButton"
                                                Content="Back"
                                                VerticalAlignment="Center"
                                                Command="{Binding CloseTesterLoginCommand}" />
                                        <Button Classes="LinkButton"
                                                Content="Switch back to live builds"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding Tester.LoginExpired}"
                                                IsEnabled="{Binding !IsBusy}"
                                                Command="{Binding SwitchToLiveBuildsCommand}" />
                                    </StackPanel>

                                    <TextBlock FontSize="12"
                                               Foreground="#D0FFFFFF"
                                               TextWrapping="Wrap"
                                               Margin="2,12,0,0"
                                               Text="{Binding Tester.LoginStatus}"
                                               IsVisible="{Binding Tester.LoginStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                            </Panel>
                        </Panel>
                    </ScrollViewer>

                    <Button Theme="{StaticResource OptionsCloseButton}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,10,12,0"
                            ToolTip.Tip="Close"
                            Command="{Binding CloseCommand}" />
                </Panel>
            </Grid>
        </Border>
    </Border>
</UserControl>
