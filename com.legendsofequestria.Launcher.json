{
    "app-id": "com.legendsofequestria.Launcher",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "25.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "LoE-Launcher",
    "finish-args": [
        "--socket=x11",
        "--share=ipc",
        "--share=network",
        "--device=dri",
        "--socket=pulseaudio"
    ],
    "modules": [
        {
            "name": "loe-launcher",
            "buildsystem": "simple",
            "build-commands": [
                "mkdir -p /app/bin",
                "cp -r launcher/. /app/bin/",
                "chmod +x /app/bin/LoE-Launcher",
                "install -Dm644 com.legendsofequestria.Launcher.desktop /app/share/applications/com.legendsofequestria.Launcher.desktop",
                "install -Dm644 com.legendsofequestria.Launcher.png /app/share/icons/hicolor/256x256/apps/com.legendsofequestria.Launcher.png",
                "install -Dm644 com.legendsofequestria.Launcher.metainfo.xml /app/share/metainfo/com.legendsofequestria.Launcher.metainfo.xml"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "Publish/Flatpak",
                    "dest": "launcher"
                },
                {
                    "type": "file",
                    "path": "com.legendsofequestria.Launcher.desktop"
                },
                {
                    "type": "file",
                    "path": "com.legendsofequestria.Launcher.png"
                },
                {
                    "type": "file",
                    "path": "com.legendsofequestria.Launcher.metainfo.xml"
                }
            ]
        }
    ]
}
